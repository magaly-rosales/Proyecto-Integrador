<?xml version="1.0" encoding="utf-8"?>

<data-extraction-rules>

    <!-- Protección frente a copias en la nube -->
    <cloud-backup>

        <exclude
            domain="sharedpref"
            path="." />

        <exclude
            domain="file"
            path="." />

        <exclude
            domain="database"
            path="." />

    </cloud-backup>

    <!-- Protección durante la transferencia entre dispositivos -->
    <device-transfer>

        <exclude
            domain="sharedpref"
            path="." />

        <exclude
            domain="file"
            path="." />

        <exclude
            domain="database"
            path="." />

    </device-transfer>

</data-extraction-rules>