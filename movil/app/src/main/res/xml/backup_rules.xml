<?xml version="1.0" encoding="utf-8"?>

<full-backup-content>

    <!-- Proteger las preferencias privadas del usuario -->
    <exclude
        domain="sharedpref"
        path="." />

    <!-- Proteger los archivos internos -->
    <exclude
        domain="file"
        path="." />

    <!-- Proteger las bases de datos locales -->
    <exclude
        domain="database"
        path="." />

</full-backup-content>